# Times Gate on your Wi-Fi. Both from the Divoom app: Device settings -> Device info.
DIVOOM_IP=192.168.1.50
DIVOOM_TOKEN=000000
# Optional: the gate's MAC address (see `arp -a`). If the router hands the gate a new IP,
# the daemon finds it again by this MAC.
DIVOOM_MAC=
# Optional: more Claude Code config folders, one per extra account, colon-separated.
# Log one in with: CLAUDE_CONFIG_DIR=~/.claude-personal claude auth login
CLAUDE_CONFIG_DIRS=
# Optional: "push" sends frames straight to the gate (shorter loading hourglass, but has been reported
# to drop the gate off Wi-Fi after many uploads). Default "pull": the gate downloads each picture.
DIVOOM_TRANSPORT=pull
